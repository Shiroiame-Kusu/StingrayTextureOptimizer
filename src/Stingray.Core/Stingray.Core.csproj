<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Required by [LibraryImport]; the only unsafe code is pinning buffers
         for the native encoder. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Stingray.Core.Tests" />
  </ItemGroup>
</Project>
