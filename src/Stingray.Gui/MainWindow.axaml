<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Stingray.Gui.ViewModels"
        xmlns:opt="clr-namespace:Stingray.Core.Optimization;assembly=Stingray.Core"
        x:Class="Stingray.Gui.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1320" Height="740" MinWidth="900" MinHeight="520">

  <DockPanel Margin="12">

    <Border DockPanel.Dock="Top" Padding="0,0,0,10">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="Open bundle…" Click="OnOpenClicked" IsEnabled="{Binding !IsBusy}" />
        <TextBlock VerticalAlignment="Center" Opacity="0.75" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding BundlePath}"
                   Text="{Binding BundlePath, FallbackValue='no bundle loaded'}" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top" Padding="0,0,0,10">
      <WrapPanel Orientation="Horizontal">
        <WrapPanel.Styles>
          <Style Selector="WrapPanel > :is(Control)">
            <Setter Property="Margin" Value="0,0,18,6" />
          </Style>
        </WrapPanel.Styles>

        <StackPanel Orientation="Horizontal" Spacing="6"
                    ToolTip.Tip="Which block format each texture is encoded to.&#x0a;BC1 is half the size of BC7 but has 5:6:5 colour endpoints, so it bands on gradients.&#x0a;BC7 reproduces any 8-bit RGBA almost exactly.&#x0a;Smallest size also uses BC1 for pure cutout masks, since BC1 carries one alpha bit.">
          <TextBlock Text="Format" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Strategies}" SelectedItem="{Binding Strategy}"
                    MinWidth="250" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6"
                    ToolTip.Tip="How hard the chosen encoder tries. Relative to that encoder, not an absolute quality target: Compressonator at Balanced beats BCnEncoder at Best.&#x0a;It never changes the output size, only quality and time.&#x0a;Balanced suits both encoders. Best buys very little for a lot of time.">
          <TextBlock Text="Effort" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding Quality}"
                    MinWidth="110" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6"
                    ToolTip.Tip="Encoder worker threads.&#x0a;Defaults to leaving four cores free so the desktop stays responsive during long encodes.">
          <TextBlock Text="Threads" VerticalAlignment="Center" />
          <NumericUpDown Value="{Binding ThreadCount}" Minimum="1" Maximum="{Binding MaxThreads}"
                         Increment="1" FormatString="0" MinWidth="110" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6"
                    ToolTip.Tip="Halve textures larger than this until they fit.&#x0a;The only lossy option here, so it is off by default.&#x0a;Each affected texture shows its measured detail cost in the Resize cost column.">
          <TextBlock Text="Max size" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding SizeCaps}" SelectedItem="{Binding SizeCap}"
                    MinWidth="130" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6"
                    ToolTip.Tip="What to do with a texture that carries a mip chain.&#x0a;Keep smaller levels: discard only the levels above the cap. The texture stays mipmapped, so it will not shimmer at distance.&#x0a;Keep one level only: throw the chain away and keep a single image. Smaller, but minified surfaces shimmer and sample less efficiently.&#x0a;Either way the pixels are the author's own: nothing is re-encoded.">
          <TextBlock Text="Mip levels" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding MipModes}" SelectedItem="{Binding MipSelection}"
                    MinWidth="170" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6"
                    ToolTip.Tip="Which compressor does the work.&#x0a;Fast uses the bundled Compressonator CMP_Core library: several times quicker and slightly better quality.&#x0a;Portable uses the pure-managed encoder, which always works.&#x0a;Automatic prefers Fast and falls back to Portable when the native library is missing.">
          <TextBlock Text="Encoder" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Backends}" SelectedItem="{Binding Encoder}"
                    MinWidth="180" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>

        <CheckBox Content="Collapse solid colours"
                  IsChecked="{Binding CollapseSolidColours}" IsEnabled="{Binding !IsBusy}"
                  ToolTip.Tip="A texture whose every pixel is identical is rewritten at 16x16.&#x0a;Visually lossless: a constant texture samples the same at any resolution.&#x0a;Saves both file size and video memory." />

        <CheckBox Content="Share duplicates"
                  IsChecked="{Binding Deduplicate}" IsEnabled="{Binding !IsBusy}"
                  ToolTip.Tip="Byte-identical payloads are stored once and referenced by every entry that uses them.&#x0a;Completely lossless, and usually the largest saving in an already-compressed bundle.&#x0a;Note: this shrinks the file only. Each entry is still its own GPU resource, so video memory is unchanged." />
      </WrapPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="0,10,0,0">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Status}" TextWrapping="Wrap"
                   VerticalAlignment="Center" Margin="0,0,12,0" />
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="12">
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontWeight="SemiBold" HorizontalAlignment="Right"
                       Text="{Binding SavingSummary}" />
            <TextBlock Opacity="0.6" FontSize="11" HorizontalAlignment="Right"
                       Text="{Binding FootprintSummary}" />
          </StackPanel>
          <Button Content="Optimize" Click="OnOptimizeClicked"
                  IsEnabled="{Binding CanOptimize}" Classes="accent" MinWidth="110" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0" Spacing="4"
                    IsVisible="{Binding IsBusy}">
          <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" />
          <TextBlock Text="{Binding ProgressText}" Opacity="0.7" FontSize="11" />
        </StackPanel>
        <!-- Column 0 is star-sized and column 1 auto, so the notice wraps into
             whatever the encoder status leaves. They must not share a cell. -->
        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,12,0"
                   Opacity="0.5" FontSize="11" TextWrapping="Wrap"
                   Text="Stingray Texture Optimizer, Copyright (C) 2026 Shiroiame-Kusu. Free software with ABSOLUTELY NO WARRANTY, redistributable under the GNU GPL v3 or later. See LICENSE." />
        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Opacity="0.5" FontSize="11"
                   VerticalAlignment="Bottom" HorizontalAlignment="Right"
                   ToolTip.Tip="The fast encoder is a small native library bundled with release downloads. Building from source? See native/README.md."
                   Text="{Binding BackendStatus}" />
        <TextBlock Grid.Row="3" Grid.Column="1" Opacity="0.4" FontSize="11"
                   HorizontalAlignment="Right" Text="{Binding VersionLabel}" />
      </Grid>
    </Border>

    <Grid RowDefinitions="*,Auto,Auto,Auto">
      <!-- Column bindings carry x:DataType inline: the grid's own bindings resolve
           against the window's view model, but each column binds a row. Without
           it these fall back to reflection bindings, which do not survive
           trimming and block a Native AOT publish. -->
      <DataGrid Grid.Row="0"
                ItemsSource="{Binding Textures}"
                AutoGenerateColumns="False"
                GridLinesVisibility="Horizontal" CanUserResizeColumns="True"
                HeadersVisibility="Column">
        <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="" Width="40"
                                  Binding="{Binding Include, x:DataType=vm:TextureItemViewModel}" />
          <DataGridTextColumn Header="Texture" IsReadOnly="True" Width="148"
                              Binding="{Binding Name, x:DataType=vm:TextureItemViewModel}" />
          <DataGridTextColumn Header="Dimensions" IsReadOnly="True" Width="200"
                              Binding="{Binding Dimensions, x:DataType=vm:TextureItemViewModel}" />
          <DataGridTextColumn Header="From" IsReadOnly="True" Width="160"
                              Binding="{Binding SourceFormat, x:DataType=vm:TextureItemViewModel}" />
          <DataGridTemplateColumn Header="To" Width="115">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:TextureItemViewModel">
                <TextBlock Text="{Binding TargetFormatName}" VerticalAlignment="Center" Margin="4,0" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
            <DataGridTemplateColumn.CellEditingTemplate>
              <DataTemplate x:DataType="vm:TextureItemViewModel">
                <!-- Disabled for a mipmapped texture: its payload is sliced out
                     of the existing chain, so the format is whatever the author
                     encoded and cannot be changed here. -->
                <ComboBox ItemsSource="{Binding AvailableFormats}"
                          SelectedItem="{Binding SelectedFormat}"
                          IsEnabled="{Binding SupportsFormatChange}"
                          ToolTip.Tip="{Binding FormatChangeHint}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellEditingTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Size" IsReadOnly="True" Width="92"
                              Binding="{Binding CurrentSizeText, x:DataType=vm:TextureItemViewModel}" />
          <DataGridTextColumn Header="New" IsReadOnly="True" Width="92"
                              Binding="{Binding PredictedSizeText, x:DataType=vm:TextureItemViewModel}" />
          <DataGridTextColumn Header="Saved" IsReadOnly="True" Width="92"
                              Binding="{Binding SavingText, x:DataType=vm:TextureItemViewModel}" />
          <DataGridTextColumn Header="Content" IsReadOnly="True" Width="1*"
                              Binding="{Binding Content, x:DataType=vm:TextureItemViewModel}" />
          <DataGridTextColumn Header="Resize cost" IsReadOnly="True" Width="2*"
                              Binding="{Binding ResizeCost, x:DataType=vm:TextureItemViewModel}">
            <DataGridTextColumn.HeaderTemplate>
              <DataTemplate>
                <TextBlock Text="Resize cost"
                           ToolTip.Tip="Detail lost by halving this texture, measured on its own pixels.&#x0a;It does not depend on the encoder, and does not need to: block compression contributes 54-78 dB while resizing contributes 30-50 dB, so the resize term dominates the total.&#x0a;Measured against the full pipeline it is accurate to about 1 dB." />
              </DataTemplate>
            </DataGridTextColumn.HeaderTemplate>
          </DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>

      <Border Grid.Row="1" Margin="0,10,0,4" Padding="10,7" CornerRadius="4"
              Background="#20808080" IsVisible="{Binding ShowDuplicateInfo}">
        <TextBlock Text="{Binding DuplicateSummary}" TextWrapping="Wrap" FontWeight="SemiBold" />
      </Border>
      <TextBlock Grid.Row="2" Margin="0,10,0,4" FontWeight="SemiBold" Text="Skipped"
                 IsVisible="{Binding HasSkipped}" />
      <ItemsControl Grid.Row="3" ItemsSource="{Binding Skipped}" MaxHeight="110">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="opt:SkippedTexture">
            <TextBlock Opacity="0.65" FontSize="12" TextWrapping="Wrap">
              <Run Text="{Binding Name}" />
              <Run Text=" — " />
              <Run Text="{Binding Description}" />
              <Run Text=" — " />
              <Run Text="{Binding Reason}" />
            </TextBlock>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </DockPanel>
</Window>
