<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Stingray.Gui.ViewModels"
        xmlns:opt="clr-namespace:Stingray.Core.Optimization;assembly=Stingray.Core"
        xmlns:loc="clr-namespace:Stingray.Gui.Localization"
        x:Class="Stingray.Gui.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1560" Height="820" MinWidth="900" MinHeight="520">

  <DockPanel Margin="12">

    <Border DockPanel.Dock="Top" Padding="0,0,0,10">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="{x:Static loc:S.OpenBundle}" Click="OnOpenClicked" IsEnabled="{Binding !IsBusy}" />
        <Button Content="{x:Static loc:S.OpenFolder}" Click="OnOpenFolderClicked"
                IsEnabled="{Binding !IsBusy}" ToolTip.Tip="{x:Static loc:S.OpenFolderHint}" />
        <TextBlock VerticalAlignment="Center" Opacity="0.75" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding BundlePath}"
                   Text="{Binding BundleLabel}" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top" Padding="0,0,0,10">
      <WrapPanel Orientation="Horizontal">
        <WrapPanel.Styles>
          <Style Selector="WrapPanel > :is(Control)">
            <Setter Property="Margin" Value="0,0,18,6" />
          </Style>
        </WrapPanel.Styles>

        <StackPanel Orientation="Horizontal" Spacing="6"
                    ToolTip.Tip="{x:Static loc:S.FormatHint}">
          <TextBlock Text="{x:Static loc:S.FormatLabel}" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Strategies}" SelectedItem="{Binding Strategy}"
                    MinWidth="250" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6"
                    ToolTip.Tip="{x:Static loc:S.EffortHint}">
          <TextBlock Text="{x:Static loc:S.EffortLabel}" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding Quality}"
                    MinWidth="110" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6"
                    ToolTip.Tip="{x:Static loc:S.ThreadsHint}">
          <TextBlock Text="{x:Static loc:S.ThreadsLabel}" VerticalAlignment="Center" />
          <NumericUpDown Value="{Binding ThreadCount}" Minimum="1" Maximum="{Binding MaxThreads}"
                         Increment="1" FormatString="0" MinWidth="110" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6"
                    ToolTip.Tip="{x:Static loc:S.MaxSizeHint}">
          <TextBlock Text="{x:Static loc:S.MaxSizeLabel}" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding SizeCaps}" SelectedItem="{Binding SizeCap}"
                    MinWidth="130" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>

        <!-- Disabled while streaming is on: a streamed texture keeps its whole
             chain, so there is nothing to drop and the choice would not apply. -->
        <StackPanel Orientation="Horizontal" Spacing="6"
                    ToolTip.Tip="{Binding MipModeHint}">
          <TextBlock Text="{x:Static loc:S.MipLevelsLabel}" VerticalAlignment="Center"
                     IsEnabled="{Binding CanChooseMipMode}" />
          <ComboBox ItemsSource="{Binding MipModes}" SelectedItem="{Binding MipSelection}"
                    MinWidth="170" IsEnabled="{Binding CanChooseMipMode}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6"
                    ToolTip.Tip="{x:Static loc:S.StreamMipsHint}">
          <TextBlock Text="{x:Static loc:S.StreamMipsLabel}" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding StreamFloors}" SelectedItem="{Binding StreamFloor}"
                    MinWidth="170" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6"
                    ToolTip.Tip="{x:Static loc:S.EncoderHint}">
          <TextBlock Text="{x:Static loc:S.EncoderLabel}" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Backends}" SelectedItem="{Binding Encoder}"
                    MinWidth="180" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>

        <CheckBox Content="{x:Static loc:S.GenerateMipmaps}"
                  IsChecked="{Binding AddMips}" IsEnabled="{Binding !IsBusy}"
                  ToolTip.Tip="{x:Static loc:S.GenerateMipmapsHint}" />

        <CheckBox Content="{x:Static loc:S.CollapseSolidColours}"
                  IsChecked="{Binding CollapseSolidColours}" IsEnabled="{Binding !IsBusy}"
                  ToolTip.Tip="{x:Static loc:S.CollapseSolidColoursHint}" />

        <CheckBox Content="{x:Static loc:S.ShareDuplicates}"
                  IsChecked="{Binding Deduplicate}" IsEnabled="{Binding !IsBusy}"
                  ToolTip.Tip="{x:Static loc:S.ShareDuplicatesHint}" />
      </WrapPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="0,10,0,0">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Status}" TextWrapping="Wrap"
                   VerticalAlignment="Center" Margin="0,0,12,0" />
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="12">
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontWeight="SemiBold" HorizontalAlignment="Right"
                       Text="{Binding SavingSummary}" />
            <TextBlock Opacity="0.6" FontSize="11" HorizontalAlignment="Right"
                       Text="{Binding FootprintSummary}" />
          </StackPanel>
          <Button Content="{Binding OptimizeLabel}" Click="OnOptimizeClicked"
                  IsEnabled="{Binding CanOptimize}" Classes="accent" MinWidth="110" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0" Spacing="4"
                    IsVisible="{Binding IsBusy}">
          <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" />
          <TextBlock Text="{Binding ProgressText}" Opacity="0.7" FontSize="11" />
        </StackPanel>
        <!-- Column 0 is star-sized and column 1 auto, so the notice wraps into
             whatever the encoder status leaves. They must not share a cell. -->
        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,12,0"
                   Opacity="0.5" FontSize="11" TextWrapping="Wrap"
                   Text="{x:Static loc:S.Notice}" />
        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Opacity="0.5" FontSize="11"
                   VerticalAlignment="Bottom" HorizontalAlignment="Right"
                   ToolTip.Tip="{x:Static loc:S.EncoderFooterHint}"
                   Text="{Binding BackendStatus}" />
        <TextBlock Grid.Row="3" Grid.Column="1" Opacity="0.4" FontSize="11"
                   HorizontalAlignment="Right" Text="{Binding VersionLabel}" />
      </Grid>
    </Border>

    <!-- Only present once a folder has been scanned, so opening a single bundle
         still gets the whole window. The tree is the folder tree: a mod packages
         its variants as folders, so nothing else can say which mod an option
         called "Shorty" belongs to. -->
    <Border DockPanel.Dock="Left" Width="360" Margin="0,0,12,0"
            IsVisible="{Binding HasMods}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontWeight="SemiBold"
                   Text="{x:Static loc:S.ModsHeader}" />
        <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0" Opacity="0.7" FontSize="11"
                   TextWrapping="Wrap" Text="{Binding SelectionSummary}" />
        <TreeView ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}"
                  IsEnabled="{Binding !IsBusy}">
          <!-- Expansion is a property of the row, not of the container, so that
               folding a mod away survives and can be set from code. -->
          <TreeView.ItemContainerTheme>
            <ControlTheme TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}"
                          x:DataType="vm:ModNodeViewModel">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </ControlTheme>
          </TreeView.ItemContainerTheme>
          <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="vm:ModNodeViewModel" ItemsSource="{Binding Children}">
              <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" IsThreeState="True"
                          VerticalAlignment="Center" Margin="0,0,6,0" />
                <!-- Bounded explicitly: the tree measures its rows with no width
                     limit, so without this a long name neither wraps nor gives
                     the scrollbar anything to scroll — it just runs off the
                     edge and is clipped. Panel width less the tick box and the
                     deepest indent. -->
                <StackPanel Grid.Column="1" MaxWidth="270">
                  <TextBlock Text="{Binding Name}" TextWrapping="Wrap"
                             ToolTip.Tip="{Binding Name}" />
                  <TextBlock Text="{Binding Detail}" Opacity="0.55" FontSize="11"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </DockPanel>
    </Border>

    <Grid RowDefinitions="*,Auto,Auto,Auto">
      <!-- Column bindings carry x:DataType inline: the grid's own bindings resolve
           against the window's view model, but each column binds a row. Without
           it these fall back to reflection bindings, which do not survive
           trimming and block a Native AOT publish. -->
      <DataGrid Grid.Row="0"
                ItemsSource="{Binding Textures}"
                AutoGenerateColumns="False"
                GridLinesVisibility="Horizontal" CanUserResizeColumns="True"
                HeadersVisibility="Column">
        <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="" Width="40"
                                  Binding="{Binding Include, x:DataType=vm:TextureItemViewModel}" />
          <DataGridTextColumn Header="{x:Static loc:S.ColumnTexture}" IsReadOnly="True" Width="148"
                              Binding="{Binding Name, x:DataType=vm:TextureItemViewModel}" />
          <DataGridTextColumn Header="{x:Static loc:S.ColumnDimensions}" IsReadOnly="True" Width="200"
                              Binding="{Binding Dimensions, x:DataType=vm:TextureItemViewModel}" />
          <DataGridTextColumn Header="{x:Static loc:S.ColumnFrom}" IsReadOnly="True" Width="160"
                              Binding="{Binding SourceFormat, x:DataType=vm:TextureItemViewModel}" />
          <DataGridTemplateColumn Header="{x:Static loc:S.ColumnTo}" Width="115">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:TextureItemViewModel">
                <TextBlock Text="{Binding TargetFormatName}" VerticalAlignment="Center" Margin="4,0" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
            <DataGridTemplateColumn.CellEditingTemplate>
              <DataTemplate x:DataType="vm:TextureItemViewModel">
                <!-- Disabled for a mipmapped texture: its payload is sliced out
                     of the existing chain, so the format is whatever the author
                     encoded and cannot be changed here. -->
                <ComboBox ItemsSource="{Binding AvailableFormats}"
                          SelectedItem="{Binding SelectedFormat}"
                          IsEnabled="{Binding SupportsFormatChange}"
                          ToolTip.Tip="{Binding FormatChangeHint}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellEditingTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="{x:Static loc:S.ColumnSize}" IsReadOnly="True" Width="92"
                              Binding="{Binding CurrentSizeText, x:DataType=vm:TextureItemViewModel}" />
          <DataGridTextColumn Header="{x:Static loc:S.ColumnNew}" IsReadOnly="True" Width="92"
                              Binding="{Binding PredictedSizeText, x:DataType=vm:TextureItemViewModel}" />
          <DataGridTextColumn Header="{x:Static loc:S.ColumnSaved}" IsReadOnly="True" Width="92"
                              Binding="{Binding SavingText, x:DataType=vm:TextureItemViewModel}" />
          <DataGridTextColumn Header="{x:Static loc:S.ColumnContent}" IsReadOnly="True" Width="1*"
                              Binding="{Binding Content, x:DataType=vm:TextureItemViewModel}" />
          <DataGridTextColumn Header="{x:Static loc:S.ColumnResizeCost}" IsReadOnly="True" Width="2*"
                              Binding="{Binding ResizeCost, x:DataType=vm:TextureItemViewModel}">
            <DataGridTextColumn.HeaderTemplate>
              <DataTemplate>
                <TextBlock Text="{x:Static loc:S.ColumnResizeCost}"
                           ToolTip.Tip="{x:Static loc:S.ResizeCostHint}" />
              </DataTemplate>
            </DataGridTextColumn.HeaderTemplate>
          </DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>

      <Border Grid.Row="1" Margin="0,10,0,4" Padding="10,7" CornerRadius="4"
              Background="#20808080" IsVisible="{Binding ShowDuplicateInfo}">
        <TextBlock Text="{Binding DuplicateSummary}" TextWrapping="Wrap" FontWeight="SemiBold" />
      </Border>
      <TextBlock Grid.Row="2" Margin="0,10,0,4" FontWeight="SemiBold" Text="{x:Static loc:S.Skipped}"
                 IsVisible="{Binding HasSkipped}" />
      <!-- An ItemsControl does not scroll on its own, so capping its height alone
           would clip the list at whatever row crossed the limit with no way to
           reach the rest. Real bundles skip dozens of textures. -->
      <ScrollViewer Grid.Row="3" MaxHeight="110" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Skipped}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="opt:SkippedTexture">
            <TextBlock Opacity="0.65" FontSize="12" TextWrapping="Wrap">
              <Run Text="{Binding Name}" />
              <Run Text=" — " />
              <Run Text="{Binding Description}" />
              <Run Text=" — " />
              <Run Text="{Binding Reason}" />
            </TextBlock>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
