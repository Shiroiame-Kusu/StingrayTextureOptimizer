<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>stingray-tex-gui</AssemblyName>
    <RootNamespace>Stingray.Gui</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!--
      Pinned to the newest version that every Avalonia package shares:
      Avalonia.Controls.DataGrid's 11.x line stops at 11.3.13, and mixing it with
      a newer core produces an inconsistent stack. Avalonia 12 is deliberately
      avoided; its restore hangs on some setups.
    -->
    <AvaloniaVersion>11.3.13</AvaloniaVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <StripSymbols>true</StripSymbols>
    <!--
      Avalonia.Controls.DataGrid is the one dependency not annotated for
      trimming, so it rolls its warnings up into these two. Everything it
      reflects over is accounted for:

        - GenerateColumn is reached only through AutoGenerateColumns, which is
          False here; every column is declared with an explicit binding.
        - UpdateDataProperties, GetItemType and GetPropertyOrIndexer resolve
          properties on the row model, which compiled bindings already reference
          and TrimmerRoots.xml pins regardless.
        - DataGridValueConverter falls back to DefaultValueConverter only when a
          column's source and target types differ; every column here binds a
          string or a bool straight through.

      A clean link says nothing about whether reflection still resolves at run
      time, so the published binary is smoke-tested by rendering the grid with a
      real bundle loaded: see the screenshot mode and native/README.md.
    -->
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="$(AvaloniaVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!--
      Avalonia.X11 pulls Tmds.DBus.Protocol 0.21.2, which is affected by
      GHSA-xrw6-gwf8-vvr9 (high: D-Bus signal spoofing / fd exhaustion).
      0.21.3 is the patch release for that line, so pin it directly to override
      the transitive reference. Revisit when Avalonia ships a newer X11 backend.
    -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Stingray.Core/Stingray.Core.csproj" />
  </ItemGroup>
</Project>
