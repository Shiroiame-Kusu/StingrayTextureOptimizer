<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Stingray.Gui/Stingray.Gui.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Linked rather than duplicated: the couplings that depend on what a bundle
      contains can only be tested against a real one, and there is no sense in
      having two fixtures that have to be kept saying the same thing.
    -->
    <Compile Include="../Stingray.Core.Tests/SyntheticBundle.cs" Link="SyntheticBundle.cs" />
  </ItemGroup>
</Project>
